{
  "schema_version": 0,
  "pack_id": "pack.core-survival-v0",
  "revision": "v0",
  "templates": [
    {
      "id": "prioritize-work",
      "method": "ui.set_work",
      "params_schema": {
        "type": "object",
        "required": ["pawn", "priorities"],
        "properties": {
          "pawn": { "type": "string" },
          "priorities": { "type": "object" }
        }
      },
      "require": ["pawn", "priorities"],
      "description": "Set a colonist's work priorities (manual mode; 0=off, 1=highest)."
    },
    {
      "id": "rescue",
      "method": "ui.job",
      "params_schema": {
        "type": "object",
        "required": ["pawn", "job", "target"],
        "properties": {
          "pawn": { "type": "string" },
          "job": { "const": "Rescue" },
          "target": { "type": "string" }
        }
      },
      "require": ["pawn", "job", "target"],
      "description": "Give a pawn the Rescue job on a downed colonist."
    },
    {
      "id": "firefight",
      "method": "ui.job",
      "params_schema": {
        "type": "object",
        "required": ["pawn", "job", "target"],
        "properties": {
          "pawn": { "type": "string" },
          "job": { "const": "Firefight" },
          "target": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 }
        }
      },
      "require": ["pawn", "job", "target"],
      "description": "Give a pawn the Firefight job at a map cell."
    },
    {
      "id": "haul-designate",
      "method": "ui.designate",
      "params_schema": {
        "type": "object",
        "required": ["designator", "cells"],
        "properties": {
          "designator": { "const": "haul" },
          "cells": { "type": "array", "items": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 } }
        }
      },
      "require": ["designator", "cells"],
      "description": "Designate hauling at map cells."
    },
    {
      "id": "forbid-item",
      "method": "ui.designate",
      "params_schema": {
        "type": "object",
        "required": ["designator", "things"],
        "properties": {
          "designator": { "const": "forbid" },
          "things": { "type": "array", "items": { "type": "string" } }
        }
      },
      "require": ["designator", "things"],
      "description": "Forbid items by id."
    },
    {
      "id": "unforbid-item",
      "method": "ui.designate",
      "params_schema": {
        "type": "object",
        "required": ["designator", "things"],
        "properties": {
          "designator": { "const": "unforbid" },
          "things": { "type": "array", "items": { "type": "string" } }
        }
      },
      "require": ["designator", "things"],
      "description": "Unforbid items by id."
    }
  ],
  "jobs": ["food", "emergency"],
  "decision_map": [
    {
      "question": "q.action",
      "choice": "forbid",
      "action": { "template_id": "forbid-item", "params": { "designator": "forbid", "things": ["{answer.thing}"] } }
    },
    {
      "question": "q.action",
      "choice": "haul",
      "action": { "template_id": "haul-designate", "params": { "designator": "haul", "cells": ["{state.haul_cell}"] } }
    },
    {
      "question": "q.action",
      "choice": "rescue",
      "action": { "template_id": "rescue", "params": { "pawn": "{state.first_colonist}", "job": "Rescue", "target": "{state.downed_id}" } }
    },
    {
      "question": "q.action",
      "choice": "firefight",
      "action": { "template_id": "firefight", "params": { "pawn": "{state.first_colonist}", "job": "Firefight", "target": "{state.fire_cell}" } }
    }
  ],
  "emergency": [
    {
      "id": "colonist-downed",
      "priority": 1,
      "condition": {
        "combinator": "any",
        "predicates": [ { "field": "colonists.downed", "op": "gte", "value": 1 } ]
      },
      "action": { "template_id": "rescue", "params": { "pawn": "{state.first_colonist}", "job": "Rescue", "target": "{state.downed_id}" } }
    },
    {
      "id": "fire-active",
      "priority": 2,
      "condition": {
        "combinator": "any",
        "predicates": [ { "field": "map.fires", "op": "gte", "value": 1 } ]
      },
      "action": { "template_id": "firefight", "params": { "pawn": "{state.first_colonist}", "job": "Firefight", "target": "{state.fire_cell}" } }
    }
  ]
}
