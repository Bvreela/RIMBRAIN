{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rimbrainagent.dev/schemas/events/types/combat.completed.schema.json",
  "title": "events/types/combat.completed",
  "description": "Payload for event_type 'combat.completed' (native type, feature 010): a bounded combat exercise finished — hostile incident spawned, defended through the dispatcher, hostiles cleared or budget exhausted, state restored. Test-mode only; never scored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "rounds", "hostiles_spawned", "hostiles_cleared",
               "colonist_casualties", "verdict"],
  "properties": {
    "mode": { "const": "combat" },
    "rounds": { "type": "integer", "minimum": 1 },
    "hostiles_spawned": { "type": "integer", "minimum": 0 },
    "hostiles_cleared": { "type": "integer", "minimum": 0 },
    "colonist_casualties": { "type": "integer", "minimum": 0 },
    "ticks": { "type": "integer", "minimum": 0 },
    "verdict": { "enum": ["cleared", "failed", "aborted"] }
  }
}
