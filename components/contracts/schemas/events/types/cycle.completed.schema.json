{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rimbrainagent.dev/schemas/events/types/cycle.completed.schema.json",
  "title": "events/types/cycle.completed",
  "description": "Payload for event_type 'cycle.completed' (native type, feature 010): one save-reset iteration finished — checkpoint reloaded, start/combat/improve phases ran. Carries per-phase verdicts so cross-cycle trends are queryable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["iteration", "checkpoint", "phases"],
  "properties": {
    "iteration": { "type": "integer", "minimum": 0 },
    "checkpoint": { "type": "string", "minLength": 1 },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "combat", "improve"],
      "properties": {
        "start": { "type": "string" },
        "combat": { "type": "string" },
        "improve": { "type": "string" }
      }
    },
    "ticks": { "type": "integer", "minimum": 0 }
  }
}
