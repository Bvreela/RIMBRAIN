{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rimbrainagent.dev/schemas/events/types/action.failed.schema.json",
  "title": "events/types/action.failed",
  "description": "Payload for event_type 'action.failed' (native type, feature 004; FR-307): the dispatched RPC failed (transport, HTTP, game error). Dispatcher stays available; failures are evidence, never silence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_revision", "template_id", "params", "outcome", "error"],
  "properties": {
    "pack_revision": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string" },
    "template_id": { "type": "string", "minLength": 1 },
    "params": { "type": "object", "additionalProperties": true },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "maxLength": 4096 },
        "retryable": { "type": "boolean" }
      }
    },
    "outcome": { "enum": ["failed"] }
  }
}
