{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rimbrainagent.dev/schemas/events/types/model.tool_result.schema.json",
  "title": "events/types/model.tool_result",
  "description": "Payload for event_type 'model.tool_result' (upstream kind 'tool_result'): {name, id, ok, text, elapsed}.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "id", "ok", "text", "elapsed"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "ok": { "type": "boolean" },
    "text": { "type": "string", "maxLength": 65536, "description": "Tool output, truncated upstream (~8k chars)." },
    "elapsed": { "type": "number", "minimum": 0 }
  }
}
